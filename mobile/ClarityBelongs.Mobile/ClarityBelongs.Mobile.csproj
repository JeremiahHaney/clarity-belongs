<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClarityBelongs.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Clarity Belongs</ApplicationTitle>
    <ApplicationId>com.claritybelongs.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\Splash\splash.svg" ForegroundFile="Resources\AppIcon\cb_launcher_icon.png" ForegroundScale="0.65" Color="#F4F7F7" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources\AppIcon\cb_launcher_icon.png" Color="#F4F7F7" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
</Project>
