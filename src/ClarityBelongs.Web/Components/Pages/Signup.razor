@page "/signup"
@attribute [AllowAnonymous]

<PageTitle>Create account - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell auth-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">START MY CLARITY</div>
        <h1>Create your account</h1>
        <p>Start free and add the public websites, endpoints, domains, certificates, or DNS records you want Clarity to watch.</p>
    </header>

    <section class="panel auth-panel">
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error-card">@GetErrorMessage(Error)</div>
        }

        <form method="post" action="/auth/signup">
            <AntiforgeryToken />

            <label class="field">
                <span>Name</span>
                <input name="displayName" autocomplete="name" maxlength="120" required />
            </label>

            <label class="field">
                <span>Email</span>
                <input name="email" type="email" autocomplete="email" maxlength="254" required />
            </label>

            <label class="field">
                <span>Password</span>
                <input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required />
            </label>

            <div class="setup-note">
                <strong>Free plan</strong>
                <span>Up to 5 active follows with a 6-hour minimum cadence. No card required.</span>
            </div>

            <button class="button full-button" type="submit">Create account</button>
        </form>

        <div class="auth-links">
            <span>Already have an account? <a href="/login">Sign in</a></span>
            <a href="/pricing">See pricing</a>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private static string GetErrorMessage(string code) => code switch
    {
        "password" => "Use a password with at least 10 characters.",
        "email" => "Enter a valid email address.",
        _ => "We could not create the account with those details. Try signing in or contact Clarity if you may already have an account."
    };
}
