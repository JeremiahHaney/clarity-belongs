@page "/settings"
@attribute [Authorize]
@inject ClarityBelongs.Web.Data.ClarityDbContext Db
@inject CurrentAccountService CurrentAccount
@rendermode InteractiveServer

<PageTitle>Settings - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">SETTINGS</div>
        <h1>Your account settings</h1>
        <p>Update the email address used to sign in to Clarity. Launch notifications are available inside My Clarity.</p>
    </header>

    <section class="panel">
        @if (User is null)
        {
            <p>Loading settings...</p>
        }
        else
        {
            <label class="field">
                <span>Account email</span>
                <input @bind="Email" type="email" autocomplete="email" placeholder="you@example.com" />
            </label>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="setup-note">@Message</div>
            }

            <button class="button" @onclick="SaveAsync">Save settings</button>
        }
    </section>

    <section class="panel">
        <h2>Notifications</h2>
        <p>Clarity records in-app notifications for changes, failures, recoveries, and supported expiration thresholds.</p>
        <p class="muted">Review notifications and history from My Clarity. Email delivery is not part of the current launch experience.</p>
    </section>
</div>

@code {
    private AppUser? User { get; set; }
    private string Email { get; set; } = string.Empty;
    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var account = await CurrentAccount.RequireAsync();

        User = await Db.Users
            .FirstOrDefaultAsync(x => x.Id == account.UserId);
        Email = User?.Email ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (User is null)
            return;

        var value = Email.Trim().ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(value)
            || !value.Contains('@'))
        {
            Message = "Enter a valid email address.";
            return;
        }

        var duplicate = await Db.Users.AnyAsync(
            x => x.Id != User.Id
                && x.Email == value);

        if (duplicate)
        {
            Message = "That email address is already used by another account.";
            return;
        }

        User.Email = value;
        await Db.SaveChangesAsync();
        Message = "Account email saved. Use this address the next time you sign in.";
    }
}
