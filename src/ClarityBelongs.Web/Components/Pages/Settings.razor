@page "/settings"
@attribute [Authorize]
@inject ClarityBelongs.Web.Data.ClarityDbContext Db
@inject CurrentAccountService CurrentAccount
@inject MembershipService Memberships
@inject IClarityEmailSender EmailSender
@rendermode InteractiveServer

<PageTitle>Clarity Settings</PageTitle>

<div class="shell narrow-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">SETTINGS</div>
        <h1>How should Clarity reach you?</h1>
        <p>In-app alerts are always recorded. Paid plans can also deliver email when a provider is configured.</p>
    </header>

    <section class="panel">
        @if (User is null || Membership is null)
        {
            <p>Loading settings...</p>
        }
        else
        {
            <label class="field">
                <span>Account and notification email</span>
                <input @bind="Email" type="email" placeholder="you@example.com" />
            </label>

            <div class="setup-note">
                <strong>Email delivery: @GetEmailDeliveryStatus()</strong>
                <span>@GetEmailDeliveryMessage()</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="setup-note">@Message</div>
            }

            <button class="button" @onclick="SaveAsync">Save settings</button>
        }
    </section>

    <section class="panel">
        <h2>Alert behavior</h2>
        <p>Clarity records in-app alerts for meaningful changes, failures, recoveries, and SSL/domain expiration thresholds.</p>
        <p class="muted">Paid plans can also create email deliveries. Expiration reminders are deduplicated at 30, 14, 7, and 1 day.</p>
    </section>
</div>

@code {
    private AppUser? User { get; set; }
    private MembershipSummary? Membership { get; set; }
    private string Email { get; set; } = string.Empty;
    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var account = await CurrentAccount.RequireAsync();

        User = await Db.Users
            .FirstOrDefaultAsync(x => x.Id == account.UserId);

        Membership = await Memberships.GetAsync(
            account.UserId,
            account.WorkspaceId);
        Email = User?.Email ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (User is null)
            return;

        var value = Email.Trim().ToLowerInvariant();

        if (string.IsNullOrWhiteSpace(value)
            || !value.Contains('@'))
        {
            Message = "Enter a valid email address.";
            return;
        }

        var duplicate = await Db.Users.AnyAsync(
            x => x.Id != User.Id
                && x.Email == value);

        if (duplicate)
        {
            Message = "That email address is already used by another account.";
            return;
        }

        User.Email = value;
        await Db.SaveChangesAsync();
        Message = "Account and notification email saved. Sign in with this address next time.";
    }

    private string GetEmailDeliveryStatus()
    {
        if (Membership?.Plan.EmailAlerts != true)
            return "Paid plan required";

        return EmailSender.IsEnabled
            ? "Provider configured"
            : "Provider not configured";
    }

    private string GetEmailDeliveryMessage()
    {
        if (Membership?.Plan.EmailAlerts != true)
            return "In-app alerts remain available on Free. Personal and Business add email delivery.";

        return EmailSender.IsEnabled
            ? "Clarity can deliver pending email alerts to the address above."
            : "Set the Email section in environment configuration before production email can send.";
    }
}
