@page "/owner"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ClarityBelongs.Web.Data.ClarityDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration

<PageTitle>Owner Operations - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@if (_loading)
{
    <div class="shell narrow-shell">
        <section class="panel"><p>Loading operations...</p></section>
    </div>
}
else if (!_authorized)
{
    <div class="shell narrow-shell">
        <section class="empty-state not-found-state">
            <div class="eyebrow">NOT FOUND</div>
            <h1>That page is not available.</h1>
            <p>The requested operations page is not available for this account.</p>
        </section>
    </div>
}
else if (_overview is not null)
{
    <div class="shell">
        <header class="hero dashboard-hero">
            <div>
                <div class="eyebrow">OWNER OPERATIONS</div>
                <h1>Clarity operations</h1>
                <p>Account, monitoring, delivery, support, and worker signals for customer support.</p>
            </div>
        </header>

        <section class="summary-grid">
            <article class="summary-card"><strong>@_overview.TotalUsers</strong><span>Users</span></article>
            <article class="summary-card"><strong>@_overview.ActiveFollows</strong><span>Active follows</span></article>
            <article class="summary-card"><strong>@_overview.AttentionFollows</strong><span>Error / attention</span></article>
            <article class="summary-card"><strong>@_overview.FailedRuns24Hours</strong><span>Failed runs · 24h</span></article>
            <article class="summary-card"><strong>@_overview.PendingNotifications</strong><span>Pending alerts</span></article>
            <article class="summary-card"><strong>@_overview.FailedNotifications</strong><span>Failed alerts</span></article>
            <article class="summary-card"><strong>@_overview.RecentFeedback</strong><span>Feedback · 24h</span></article>
            <article class="summary-card"><strong>@_overview.RecentContacts</strong><span>Contact · 24h</span></article>
        </section>

        <section class="panel">
            <div class="eyebrow">WORKER HEALTH</div>
            <h2>Background activity</h2>
            <div class="row"><div><strong>Observation worker</strong><div class="muted">@FormatHeartbeat(_overview.ObservationHeartbeatUtc)</div></div></div>
            <div class="row"><div><strong>Expiration worker</strong><div class="muted">@FormatHeartbeat(_overview.ExpirationHeartbeatUtc)</div></div></div>
            <div class="row"><div><strong>Notification worker</strong><div class="muted">@FormatHeartbeat(_overview.NotificationHeartbeatUtc)</div></div></div>
            <div class="row"><div><strong>Due follows</strong><div class="muted">Oldest due: @FormatAge(_overview.OldestDueAgeMinutes)</div></div><div class="badge">@_overview.DueFollows</div></div>
        </section>

        <section class="panel">
            <div class="eyebrow">USERS & WORKSPACES</div>
            <h2>Find an account</h2>
            <div class="action-row">
                <input @bind="_userQuery" placeholder="Email" aria-label="Search users by email" />
                <button type="button" @onclick="SearchUsersAsync">Search</button>
            </div>
            @foreach (var user in _users)
            {
                <div class="row">
                    <div>
                        <strong>@user.Email</strong>
                        <div class="muted">@user.DisplayName · @user.WorkspaceName (#@user.WorkspaceId) · created @user.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                    </div>
                    <div class="badge">@user.PlanCode / @user.MembershipStatus · @user.ActiveFollowCount active</div>
                </div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">FOLLOW LOOKUP</div>
            <h2>Find a monitor</h2>
            <div class="action-row">
                <input @bind="_followQuery" placeholder="Follow ID, target, or user email" aria-label="Search follows" />
                <button type="button" @onclick="SearchFollowsAsync">Search</button>
            </div>
            @foreach (var follow in _follows)
            {
                <article class="row" id="follow-@follow.FollowId">
                    <div>
                        <strong>#@follow.FollowId · @follow.Name</strong>
                        <div class="muted">@follow.UserEmail · @follow.WorkspaceName · @follow.Target</div>
                        <div class="muted">@follow.MonitorType / @follow.AdapterType · cadence @follow.CadenceMinutes min · next @follow.NextCheckAtUtc.ToLocalTime().ToString("g")</div>
                        <div class="muted">State: @follow.Status · last checked @(follow.LastCheckedAtUtc?.ToLocalTime().ToString("g") ?? "never")</div>
                        <div class="muted">Latest run: @(follow.LatestObservationStatus ?? "No observation yet") @(follow.LatestObservationUtc?.ToLocalTime().ToString("g"))</div>
                        @if (!string.IsNullOrWhiteSpace(follow.LatestErrorMessage))
                        {
                            <div class="muted">Latest error: @follow.LatestErrorCode · @follow.LatestErrorMessage</div>
                        }
                        @foreach (var change in follow.RecentChanges)
                        {
                            <div class="muted">Change: @change</div>
                        }
                    </div>
                </article>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">FAILED OBSERVATIONS</div>
            <h2>Recent failures</h2>
            @foreach (var failure in _failures)
            {
                <div class="row">
                    <div>
                        <strong>@failure.AdapterType · @failure.Target</strong>
                        <div class="muted">@failure.TimestampUtc.ToLocalTime().ToString("g") · @failure.UserEmail · @failure.WorkspaceName</div>
                        <div class="muted">@failure.ErrorCategory · @failure.ErrorSummary</div>
                    </div>
                </div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">NOTIFICATIONS</div>
            <h2>Delivery history</h2>
            @foreach (var notification in _notifications)
            {
                <div class="row">
                    <div>
                        <strong>@notification.Status · @notification.Channel · @notification.UserEmail</strong>
                        <div class="muted">@notification.Type · queued @notification.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                        @if (notification.SentAtUtc is not null)
                        {
                            <div class="muted">Sent @notification.SentAtUtc.Value.ToLocalTime().ToString("g")</div>
                        }
                        @if (notification.FailedAtUtc is not null)
                        {
                            <div class="muted">Failed @notification.FailedAtUtc.Value.ToLocalTime().ToString("g")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(notification.LastError))
                        {
                            <div class="muted">Last error: @notification.LastError</div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">FEEDBACK & CONTACT</div>
            <h2>Recent customer messages</h2>
            <p class="muted">Feedback is product input. Contact is an account or support request.</p>
            @foreach (var message in _messages)
            {
                <div class="row">
                    <div>
                        <strong>@message.Source · @message.Type</strong>
                        <div class="muted">@message.CreatedUtc.ToLocalTime().ToString("g") · @(message.Contact ?? "No reply email")</div>
                        <div>@message.Message</div>
                    </div>
                </div>
            }
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private bool _authorized;
    private OwnerOverview? _overview;
    private string _userQuery = string.Empty;
    private string _followQuery = string.Empty;
    private IReadOnlyList<OwnerUserRow> _users = [];
    private IReadOnlyList<OwnerFollowRow> _follows = [];
    private IReadOnlyList<OwnerFailedObservationRow> _failures = [];
    private IReadOnlyList<OwnerNotificationRow> _notifications = [];
    private IReadOnlyList<OwnerMessageRow> _messages = [];
    private OwnerOperationsService Operations => new(Db);

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _authorized = OwnerAccess.IsOwner(principal, Configuration);

        if (!_authorized)
        {
            _loading = false;
            return;
        }

        _overview = await Operations.GetOverviewAsync();
        _users = await Operations.SearchUsersAsync(null);
        _follows = await Operations.SearchFollowsAsync(null);
        _failures = await Operations.GetFailuresAsync();
        _notifications = await Operations.GetNotificationsAsync();
        _messages = await Operations.GetMessagesAsync();
        _loading = false;
    }

    private async Task SearchUsersAsync() =>
        _users = await Operations.SearchUsersAsync(_userQuery);

    private async Task SearchFollowsAsync() =>
        _follows = await Operations.SearchFollowsAsync(_followQuery);

    private static string FormatHeartbeat(DateTime? utc) =>
        utc is null
            ? "No heartbeat recorded since this app instance started."
            : $"Last activity {utc.Value.ToLocalTime():g}";

    private static string FormatAge(double? minutes) =>
        minutes is null
            ? "Nothing overdue"
            : minutes < 1
                ? "under a minute"
                : $"{minutes.Value:N0} minutes";
}
