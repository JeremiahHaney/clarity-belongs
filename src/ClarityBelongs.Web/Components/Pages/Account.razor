@page "/account"
@attribute [Authorize]
@inject CurrentAccountService CurrentAccount
@inject MembershipService Memberships
@rendermode InteractiveServer

<PageTitle>Account - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">ACCOUNT</div>
        <h1>Your Clarity account</h1>
        <p>Review your current plan, capacity, and account settings.</p>
    </header>

    @if (Session is null || Summary is null)
    {
        <section class="panel"><p>Loading your account...</p></section>
    }
    else
    {
        <section class="panel account-card">
            <div class="account-heading">
                <div>
                    <div class="eyebrow">SIGNED IN</div>
                    <h2>@Session.DisplayName</h2>
                    <p class="muted">@Session.Email</p>
                </div>
                <span class="badge">@Summary.Plan.Name</span>
            </div>

            <div class="account-stats">
                <div>
                    <strong>@Summary.ActiveFollowCount</strong>
                    <span>active follows</span>
                </div>
                <div>
                    <strong>@Summary.RemainingFollows</strong>
                    <span>remaining</span>
                </div>
                <div>
                    <strong>@Summary.Plan.MaxActiveFollows</strong>
                    <span>plan limit</span>
                </div>
            </div>

            <p>@Summary.Plan.Description</p>
            <p class="muted">Fastest available cadence on this plan: @FormatCadence(Summary.Plan.MinimumCadenceMinutes).</p>

            <div class="action-row">
                <a class="button" href="/add">Watch something</a>
                <a class="button secondary" href="/settings">Notification settings</a>
            </div>
        </section>

        <section class="panel">
            <h2>Plan limits</h2>
            <div class="limit-row"><span>Active follows</span><strong>@Summary.Plan.MaxActiveFollows</strong></div>
            <div class="limit-row"><span>Minimum cadence</span><strong>@FormatCadence(Summary.Plan.MinimumCadenceMinutes)</strong></div>
            <div class="limit-row"><span>Notifications</span><strong>In-app</strong></div>
        </section>

        <section class="panel">
            <h2>Need help?</h2>
            <p class="muted">Visit Support for common questions or Contact for account assistance.</p>
            <div class="action-row">
                <a class="button secondary" href="/support">Support</a>
                <a class="button secondary" href="/contact">Contact</a>
            </div>
        </section>

        <section class="panel">
            <h2>Sign out</h2>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button class="button secondary" type="submit">Sign out</button>
            </form>
        </section>
    }
</div>

@code {
    private AccountSession? Session { get; set; }
    private MembershipSummary? Summary { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Session = await CurrentAccount.GetAsync();

        if (Session is null)
            return;

        Summary = await Memberships.GetAsync(
            Session.UserId,
            Session.WorkspaceId);
    }

    private static string FormatCadence(int minutes)
    {
        if (minutes >= 1440)
            return $"{minutes / 1440} day";

        if (minutes >= 60)
            return $"{minutes / 60} hours";

        return $"{minutes} minutes";
    }
}
