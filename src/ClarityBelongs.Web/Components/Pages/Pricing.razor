@page "/pricing"
@attribute [AllowAnonymous]
@inject PlanCatalog Plans

<PageTitle>Pricing - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="description" content="Start Clarity Belongs free with up to five active follows and in-app notifications." />
</HeadContent>

<div class="shell">
    <header class="hero compact-hero pricing-hero">
        <div class="eyebrow">PRICING</div>
        <h1>Start free.</h1>
        <p>Clarity is currently available on its Free plan. You can watch up to five things, build history, and review changes in My Clarity without entering a card.</p>
    </header>

    <section class="plan-grid single-plan-grid">
        <article class="plan-card featured-plan">
            <div class="eyebrow">FREE</div>
            <h2>Free</h2>
            <div class="plan-price">$0</div>
            <p>Enough room to put Clarity to work on a few things that matter.</p>
            <ul class="feature-list">
                <li>Up to @FreePlan.MaxActiveFollows active follows</li>
                <li>Checks as often as every @FormatCadence(FreePlan.MinimumCadenceMinutes)</li>
                <li>Saved history in My Clarity</li>
                <li>In-app notifications</li>
                <li>No card required</li>
            </ul>
            <AuthorizeView>
                <Authorized>
                    <a class="button full-button" href="/add">Watch something</a>
                </Authorized>
                <NotAuthorized>
                    <a class="button full-button" href="/signup">Start free</a>
                </NotAuthorized>
            </AuthorizeView>
        </article>
    </section>

    <section class="panel pricing-note">
        <h2>What about paid plans?</h2>
        <p class="muted">Clarity is launching with the Free plan only. Paid options will appear here only when billing and the paid features are ready to use.</p>
    </section>
</div>

@code {
    private MembershipPlanDefinition FreePlan => Plans.Get(MembershipPlans.Free);

    private static string FormatCadence(int minutes)
    {
        if (minutes >= 1440)
            return $"{minutes / 1440} day";

        if (minutes >= 60)
            return $"{minutes / 60} hours";

        return $"{minutes} minutes";
    }
}
