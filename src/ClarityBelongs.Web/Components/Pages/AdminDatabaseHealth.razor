@page "/admin/health/database"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ClarityBelongs.Web.Data.ClarityDbContext Db
@rendermode InteractiveServer

<PageTitle>Database Health · Clarity Belongs</PageTitle>

<div class="shell">
    <header class="hero dashboard-hero">
        <div>
            <div class="eyebrow">ADMIN · DATABASE HEALTH</div>
            <h1>Database health</h1>
            <p>Connection state, SQLite size, schema counts, and row volume across Clarity operational tables.</p>
        </div>
        <a class="button secondary" href="/admin">Admin</a>
    </header>

    @if (_loading)
    {
        <section class="panel"><p>Loading database health...</p></section>
    }
    else if (!_authorized)
    {
        <section class="panel"><h2>Admin access required.</h2></section>
    }
    else if (_snapshot is not null)
    {
        <section class="summary-grid">
            <article class="summary-card"><strong>@(_snapshot.Available ? "Healthy" : "Unavailable")</strong><span>Connection</span></article>
            <article class="summary-card"><strong>@_snapshot.DatabaseSizeMb.ToString("N2") MB</strong><span>Database size</span></article>
            <article class="summary-card"><strong>@_snapshot.TableCount</strong><span>Tables</span></article>
            <article class="summary-card"><strong>@_snapshot.Tables.Sum(row => row.Rows).ToString("N0")</strong><span>Total rows</span></article>
        </section>

        <section class="panel">
            <div class="eyebrow">CONNECTION</div>
            <h2>Clarity operational store</h2>
            <div class="row"><div><strong>Provider</strong><div class="muted">@_snapshot.Provider</div></div><div class="badge">@(_snapshot.Available ? "Healthy" : "Failed")</div></div>
            <div class="row"><div><strong>Data source</strong><div class="muted">@(string.IsNullOrWhiteSpace(_snapshot.DataSource) ? "Unavailable" : _snapshot.DataSource)</div></div></div>
            <div class="row"><div><strong>Indexes</strong><div class="muted">@_snapshot.IndexCount.ToString("N0") application indexes</div></div></div>
            @if (!string.IsNullOrWhiteSpace(_snapshot.Error))
            {
                <div class="row"><div><strong>Error</strong><div class="muted">@_snapshot.Error</div></div></div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">TABLE ACTIVITY</div>
            <h2>Rows by table</h2>
            @foreach (var row in _snapshot.Tables)
            {
                <div class="row"><strong>@row.Name</strong><div class="badge">@row.Rows.ToString("N0") rows</div></div>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private bool _authorized;
    private DatabaseHealthSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _authorized = AdminAccess.IsAllowed(state.User, Configuration);

        if (_authorized)
            _snapshot = await new DatabaseHealthService(Db).GetAsync();

        _loading = false;
    }
}
