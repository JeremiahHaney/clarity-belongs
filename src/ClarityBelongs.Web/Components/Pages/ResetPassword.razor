@page "/reset-password"
@attribute [AllowAnonymous]

<PageTitle>Choose new password - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell auth-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">PASSWORD RESET</div>
        <h1>Choose a new password</h1>
        <p>A valid reset link can be used once and expires after one hour.</p>
    </header>

    <section class="panel auth-panel">
        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="error-card">This page needs a valid password-reset link.</div>
            <div class="action-row">
                <a class="button" href="/contact">Contact Clarity</a>
                <a class="button secondary" href="/login">Back to sign in</a>
            </div>
        }
        else
        {
            @if (Error == "invalid")
            {
                <div class="error-card">That reset link is invalid or expired. Contact Clarity if you still need account access help.</div>
            }
            else if (Error == "password")
            {
                <div class="error-card">Use a password with at least 10 characters.</div>
            }

            <form method="post" action="/auth/reset-password">
                <AntiforgeryToken />
                <input type="hidden" name="token" value="@Token" />

                <label class="field">
                    <span>New password</span>
                    <input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required />
                </label>

                <button class="button full-button" type="submit">Save new password</button>
            </form>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
