@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Page not found - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell">
    <section class="empty-state not-found-state">
        <div class="eyebrow">404</div>
        <h1>We could not find that page.</h1>
        <p>The link may be old, incomplete, or no longer public.</p>
        <div class="action-row">
            <a class="button" href="/">Go home</a>
            <a class="button secondary" href="/products">See what Clarity watches</a>
            <a class="button secondary" href="/support">Support</a>
        </div>
    </section>
</div>

@code {
    protected override void OnInitialized()
    {
        if (HttpContextAccessor.HttpContext is { Response.HasStarted: false } context)
            context.Response.StatusCode = StatusCodes.Status404NotFound;
    }
}
