@page "/forgot-password"
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Options.IOptions<EmailOptions> EmailConfig

<PageTitle>Reset password - Clarity Belongs</PageTitle>

<div class="shell narrow-shell auth-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">PASSWORD RESET</div>
        <h1>Get back into My Clarity</h1>
        @if (EmailReady)
        {
            <p>Enter your account email. If the account exists, we will send a one-hour reset link.</p>
        }
        else
        {
            <p>Automated password-reset email is not enabled for the current launch.</p>
        }
    </header>

    <section class="panel auth-panel">
        @if (!EmailReady)
        {
            <div class="setup-note">
                <strong>Need account help?</strong>
                <span>Use the Support page for the current account recovery path. Clarity will not claim an email was sent when email delivery is disabled.</span>
            </div>

            <div class="auth-links">
                <a href="/support">Open Support</a>
                <a href="/login">Back to sign in</a>
            </div>
        }
        else
        {
            @if (Sent == "1")
            {
                <div class="setup-note">
                    <strong>Check your email</strong>
                    <span>If that address belongs to a Clarity account, a reset link has been sent.</span>
                </div>
            }

            <form method="post" action="/auth/forgot-password">
                <AntiforgeryToken />

                <label class="field">
                    <span>Email</span>
                    <input name="email" type="email" autocomplete="email" maxlength="254" required />
                </label>

                <button class="button full-button" type="submit">Send reset link</button>
            </form>

            <div class="auth-links">
                <a href="/login">Back to sign in</a>
            </div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }

    private bool EmailReady => EmailConfiguration.IsPublicReady(EmailConfig.Value);
}
