@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Account access help - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell narrow-shell auth-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">ACCOUNT ACCESS</div>
        <h1>Need help signing in?</h1>
        <p>Automatic password-reset email is not part of the current launch experience. Contact Clarity and include the email address on your account so the issue can be reviewed.</p>
    </header>

    <section class="panel auth-panel">
        <div class="action-row">
            <a class="button" href="/contact">Contact Clarity</a>
            <a class="button secondary" href="/login">Back to sign in</a>
        </div>
    </section>
</div>
