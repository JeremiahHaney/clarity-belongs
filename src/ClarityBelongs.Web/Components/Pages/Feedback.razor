@page "/feedback"
@attribute [AllowAnonymous]

<PageTitle>Product feedback - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="description" content="Share product feedback, report a problem, or suggest an improvement for Clarity Belongs." />
</HeadContent>

<div class="shell narrow-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">PRODUCT FEEDBACK</div>
        <h1>Help make Clarity better.</h1>
        <p>Use this page for product ideas, bug reports, and feedback about your experience. For account or support questions, use <a href="/contact">Contact</a>.</p>
    </header>

    @if (Status == "sent")
    {
        <div class="setup-note">
            <strong>Thanks. Your feedback was received.</strong>
            <span>We use submissions to understand what is working and what needs attention.</span>
        </div>
    }
    else if (Status == "limited")
    {
        <div class="error-card">Too many submissions were received from this connection. Please try again later.</div>
    }
    else if (Status is "invalid" or "error")
    {
        <div class="error-card">We could not accept that feedback. Check the form and try again.</div>
    }

    <form method="post" action="/feedback/submit" class="panel feedback-form">
        <AntiforgeryToken />
        <input type="hidden" name="product" value="@Product" />
        <input type="hidden" name="source" value="@Source" />
        <input type="hidden" name="version" value="@Version" />

        <label class="field">
            <span>Feedback type</span>
            <select name="kind">
                <option value="general">General feedback</option>
                <option value="bug">Report a problem</option>
                <option value="idea">Suggest an improvement</option>
                <option value="positive">Something worked well</option>
            </select>
        </label>

        <label class="field">
            <span>Your feedback</span>
            <textarea name="message" rows="6" maxlength="4000" required></textarea>
        </label>

        <label class="field">
            <span>Email <small>(optional)</small></span>
            <input name="contact" type="email" maxlength="320" autocomplete="email" />
        </label>

        <p class="muted">You can submit anonymously. Add an email only if you are comfortable being contacted about this feedback.</p>
        <button class="button" type="submit">Send feedback</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Product { get; set; }

    [SupplyParameterFromQuery]
    public string? Source { get; set; }

    [SupplyParameterFromQuery]
    public string? Version { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }
}
