@page "/feedback"
@attribute [AllowAnonymous]

<PageTitle>Feedback - Clarity Belongs</PageTitle>

<div class="page-shell" style="max-width: 760px; margin: 0 auto; padding: 3rem 1.25rem 4rem;">
    <h1>Help improve Clarity</h1>
    <p>
        Use Feedback for product ideas, bug reports, and comments about what worked or what would make Clarity more useful.
        For account, billing, monitor, alert, privacy, or customer-support help, use <a href="/contact">Contact</a> instead.
    </p>

    @if (Status == "sent")
    {
        <div class="panel" style="margin: 1.5rem 0;">
            <strong>Thanks. Your feedback was received.</strong>
        </div>
    }
    else if (Status == "limited")
    {
        <div class="panel" style="margin: 1.5rem 0;">
            <strong>Too many submissions were received from this connection. Try again later.</strong>
        </div>
    }
    else if (Status is "invalid" or "error")
    {
        <div class="panel" style="margin: 1.5rem 0;">
            <strong>We could not accept that feedback. Check the form and try again.</strong>
        </div>
    }

    <form method="post" action="/feedback/submit" class="panel" style="display: grid; gap: 1rem; margin-top: 1.5rem;">
        <AntiforgeryToken />
        <input type="hidden" name="product" value="@Product" />
        <input type="hidden" name="source" value="@Source" />
        <input type="hidden" name="version" value="@Version" />

        <label>
            <span>Feedback type</span>
            <select name="kind" style="display: block; width: 100%; margin-top: .4rem;">
                <option value="general">General feedback</option>
                <option value="bug">Report a product problem</option>
                <option value="idea">Suggest an improvement</option>
                <option value="positive">Something worked well</option>
            </select>
        </label>

        <label>
            <span>Your feedback</span>
            <textarea name="message" rows="6" maxlength="4000" required style="display: block; width: 100%; margin-top: .4rem;"></textarea>
        </label>

        <label>
            <span>Email (optional)</span>
            <input name="contact" type="email" maxlength="320" style="display: block; width: 100%; margin-top: .4rem;" />
        </label>

        <p style="margin: 0; opacity: .75;">
            You can submit anonymously. Add an email only if you are okay with us contacting you about this feedback.
        </p>

        <div>
            <button type="submit">Send feedback</button>
        </div>
    </form>

    <div class="panel" style="margin-top: 1.5rem;">
        <strong>Did Clarity work for you?</strong>
        <div style="display: flex; gap: .75rem; margin-top: .75rem;">
            <form method="post" action="/feedback/submit">
                <AntiforgeryToken />
                <input type="hidden" name="kind" value="useful-yes" />
                <input type="hidden" name="product" value="@Product" />
                <input type="hidden" name="source" value="@Source" />
                <input type="hidden" name="version" value="@Version" />
                <button type="submit">Yes</button>
            </form>
            <form method="post" action="/feedback/submit">
                <AntiforgeryToken />
                <input type="hidden" name="kind" value="useful-no" />
                <input type="hidden" name="product" value="@Product" />
                <input type="hidden" name="source" value="@Source" />
                <input type="hidden" name="version" value="@Version" />
                <button type="submit">No</button>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Product { get; set; }

    [SupplyParameterFromQuery]
    public string? Source { get; set; }

    [SupplyParameterFromQuery]
    public string? Version { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }
}
