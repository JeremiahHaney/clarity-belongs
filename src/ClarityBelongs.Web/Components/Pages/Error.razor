@page "/error"

<PageTitle>Clarity error</PageTitle>

<div class="shell narrow-shell">
    <header class="hero compact-hero">
        <div class="eyebrow">CLARITY BELONGS</div>
        <h1>Something went wrong.</h1>
        <p>The current action could not be completed. Your existing Clarity history is still separate from this error.</p>
    </header>

    <section class="panel">
        <p>Return to My Clarity and try again. If a monitor itself failed, it will appear as needing attention and the scheduler will retry it.</p>
        <a class="button" href="/">Back to My Clarity</a>
    </section>
</div>
