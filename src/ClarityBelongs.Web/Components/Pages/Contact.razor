@page "/contact"
@attribute [AllowAnonymous]

<PageTitle>Contact - Clarity Belongs</PageTitle>
<HeadContent>
    <meta name="description" content="Contact Clarity Belongs for product feedback and support questions." />
</HeadContent>

<div class="shell public-shell article-shell">
    <header class="hero compact-hero article-hero">
        <div class="eyebrow">CONTACT</div>
        <h1>Need to reach us?</h1>
        <p class="public-lead">Use the feedback form for product questions, problems, and early-release feedback.</p>
    </header>

    <article class="article-body">
        <section>
            <h2>Product feedback and support</h2>
            <p>Clarity's public V1 uses the built-in feedback channel so reports stay attached to the product and release context.</p>
            <div class="action-row">
                <a class="button" href="/feedback?source=contact">Open feedback form</a>
                <a class="button secondary" href="/support">View support</a>
            </div>
        </section>
    </article>
</div>
