@page "/learn"
@page "/learn/{Slug}"
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@PageTitleText</PageTitle>

@if (IsMissingArticle)
{
    <HeadContent>
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>

    <div class="shell narrow-shell">
        <section class="empty-state not-found-state">
            <div class="eyebrow">NOT FOUND</div>
            <h1>That guide is not available.</h1>
            <p>The link may be old, or the guide may no longer be part of the public Learn library.</p>
            <div class="action-row">
                <a class="button" href="/learn">Browse Learn</a>
                <a class="button secondary" href="/">Go home</a>
            </div>
        </section>
    </div>
}
else if (Entry is null)
{
    <div class="shell public-shell">
        <header class="hero compact-hero">
            <div class="eyebrow">LEARN</div>
            <h1>Start with the problem.</h1>
            <p>Plain-language guides for monitoring public websites, endpoints, domains, certificates, and DNS.</p>
        </header>

        <section class="learn-grid">
            @foreach (var entry in LearnCatalog.GetAll())
            {
                <a class="learn-card" href="/learn/@entry.Slug">
                    <div class="eyebrow">@entry.SearchIntent</div>
                    <h2>@entry.Title</h2>
                    <p>@entry.Description</p>
                    <span>Read guide →</span>
                </a>
            }
        </section>
    </div>
}
else
{
    <HeadContent>
        <meta name="description" content="@Entry.Description" />
    </HeadContent>

    <div class="shell public-shell article-shell">
        <header class="hero compact-hero article-hero">
            <div class="eyebrow">CLARITY GUIDE</div>
            <h1>@Entry.Title</h1>
            <p class="public-lead">@Entry.Description</p>
        </header>

        <article class="article-body">
            <section>
                <h2>The simple answer</h2>
                <p>Give Clarity a supported public target once. Clarity records a baseline, checks it on a schedule, saves later observations, and records a change when the stored result differs.</p>
            </section>

            <section>
                <h2>How to do it</h2>
                <ol class="steps-list">
                    @foreach (var step in Entry.Steps)
                    {
                        <li>@step</li>
                    }
                </ol>
            </section>

            <section>
                <h2>Questions people usually have</h2>
                <div class="faq-list">
                    @foreach (var question in Entry.Questions)
                    {
                        <details>
                            <summary>@question</summary>
                            <p>Clarity records factual observations and compares them over time. The exact result depends on the selected watch and the public data available from the target.</p>
                        </details>
                    }
                </div>
            </section>

            <section class="article-cta">
                <div>
                    <div class="eyebrow">TRY IT</div>
                    <h2>@Entry.ProductName</h2>
                    <p>See whether this watch is in Clarity's current public catalog and start free if it is available.</p>
                </div>
                <a class="button" href="/products/@Entry.ProductSlug">See the watch</a>
            </section>

            <section class="related-links">
                <h2>Related guides</h2>
                @foreach (var related in LearnCatalog.GetAll().Where(x => x.Slug != Entry.Slug).Take(5))
                {
                    <a href="/learn/@related.Slug">@related.Title</a>
                }
            </section>
        </article>
    </div>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private LearnContentCatalog LearnCatalog { get; } = new();
    private LearnEntry? Entry => LearnCatalog.GetBySlug(Slug);
    private bool IsMissingArticle => !string.IsNullOrWhiteSpace(Slug)
        && Entry is null;
    private string PageTitleText => IsMissingArticle
        ? "Guide not found - Clarity Belongs"
        : Entry is null
            ? "Learn - Clarity Belongs"
            : $"{Entry.Title} - Clarity Belongs";

    protected override void OnParametersSet()
    {
        if (IsMissingArticle
            && HttpContextAccessor.HttpContext is { Response.HasStarted: false } context)
        {
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
            context.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
