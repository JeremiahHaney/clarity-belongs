@page "/my-clarity"
@attribute [Authorize]
@inject MyClarityService Clarity
@inject CurrentAccountService CurrentAccount
@rendermode InteractiveServer

<PageTitle>My Clarity</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="shell">
    <header class="hero dashboard-hero">
        <div>
            <div class="eyebrow">MY CLARITY</div>
            <h1>What changed?</h1>
            <p>One place for what needs attention, what changed, and what you are following.</p>
        </div>
        <a class="button" href="/add">Add a follow</a>
    </header>

    @if (_dashboard is null)
    {
        <section class="panel">
            <p>Loading Clarity...</p>
        </section>
    }
    else if (_dashboard.Following.Count == 0)
    {
        <section class="empty-state">
            <div class="eyebrow">START HERE</div>
            <h2>Stop checking things manually.</h2>
            <p>Choose something you care about. Clarity will establish a baseline, keep checking it, and show you what changed.</p>
            <div class="action-row">
                <a class="button" href="/add">Follow something</a>
                <a class="button secondary" href="/products">See what Clarity watches</a>
            </div>
        </section>
    }
    else
    {
        <section class="summary-grid">
            <article class="summary-card">
                <strong>@_dashboard.NeedsAttention.Count</strong>
                <span>Need attention</span>
            </article>
            <article class="summary-card">
                <strong>@_dashboard.RecentChanges.Count</strong>
                <span>Recent changes</span>
            </article>
            <article class="summary-card">
                <strong>@_dashboard.Following.Count</strong>
                <span>Following</span>
            </article>
        </section>

        <section class="panel">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">NOW</div>
                    <h2>Needs Attention</h2>
                </div>
            </div>

            @if (_dashboard.NeedsAttention.Count == 0)
            {
                <p class="muted">Nothing needs your attention right now.</p>
            }
            else
            {
                @foreach (var item in _dashboard.NeedsAttention)
                {
                    <a class="row row-link" href="/follows/@item.FollowId">
                        <div>
                            <strong>@item.Name</strong>
                            <div class="muted">@item.MonitorType · @item.Status</div>
                        </div>
                        <div class="badge">@item.UnacknowledgedChangeCount new</div>
                    </a>
                }
            }
        </section>

        <section class="panel">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">SINCE YOU WERE HERE</div>
                    <h2>Recent Changes</h2>
                </div>
            </div>

            @if (_dashboard.RecentChanges.Count == 0)
            {
                <p class="muted">No changes have been recorded yet.</p>
            }
            else
            {
                @foreach (var item in _dashboard.RecentChanges)
                {
                    <a class="change row-link" href="/follows/@item.FollowId">
                        <div class="change-topline">
                            <strong>@item.Title</strong>
                            <span>@item.DetectedAtUtc.ToLocalTime().ToString("g")</span>
                        </div>
                        <div>@item.Summary</div>
                        <div class="muted">@item.FollowName · @item.Severity</div>
                    </a>
                }
            }
        </section>

        <section class="panel">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">EVERYTHING</div>
                    <h2>Following</h2>
                </div>
                <a href="/add">Add another</a>
            </div>

            @foreach (var item in _dashboard.Following)
            {
                <a class="row row-link" href="/follows/@item.FollowId">
                    <div>
                        <strong>@item.Name</strong>
                        <div class="muted">@item.MonitorType · @item.Importance</div>
                    </div>
                    <div class="right">
                        <div>@item.Status</div>
                        <div class="muted">Next @item.NextCheckAtUtc.ToLocalTime().ToString("g")</div>
                    </div>
                </a>
            }
        </section>

        <section class="panel">
            <div class="section-heading">
                <div>
                    <div class="eyebrow">NOTIFICATIONS</div>
                    <h2>Latest in-app notifications</h2>
                </div>
            </div>

            @if (VisibleNotifications.Count == 0)
            {
                <p class="muted">No in-app notifications have been created yet.</p>
            }
            else
            {
                @foreach (var notification in VisibleNotifications.Take(10))
                {
                    <a class="row row-link" href="/follows/@notification.FollowId">
                        <div>
                            <strong>@notification.Subject</strong>
                            <div class="muted">@notification.Status</div>
                        </div>
                        <span class="muted">@notification.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                    </a>
                }
            }
        </section>
    }
</div>

@code {
    private MyClarityDashboard? _dashboard;

    private IReadOnlyList<NotificationItem> VisibleNotifications => _dashboard?.Notifications
        .Where(notification => string.Equals(
            notification.Channel,
            "InApp",
            StringComparison.OrdinalIgnoreCase))
        .ToList()
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        var account = await CurrentAccount.RequireAsync();
        _dashboard = await Clarity.GetAsync(account.WorkspaceId);
    }
}
