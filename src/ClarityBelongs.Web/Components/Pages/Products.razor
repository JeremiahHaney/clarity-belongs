@page "/products"
@page "/products/{Slug}"
@inject ClarityProductCatalog Catalog
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@TitleText</PageTitle>

@if (IsMissingProduct)
{
    <HeadContent>
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>

    <div class="shell narrow-shell">
        <section class="empty-state not-found-state">
            <div class="eyebrow">NOT FOUND</div>
            <h1>That watch is not available.</h1>
            <p>The link may be old, or the watch may not be part of Clarity's current public catalog.</p>
            <div class="action-row">
                <a class="button" href="/products">See what Clarity watches</a>
                <a class="button secondary" href="/">Go home</a>
            </div>
        </section>
    </div>
}
else if (Product is not null)
{
    <HeadContent>
        <meta name="description" content="@Product.ShortDescription" />
    </HeadContent>

    <div class="shell public-shell">
        <header class="hero compact-hero product-public-hero">
            <div class="eyebrow">@Product.Family.ToUpperInvariant()</div>
            <h1>@Product.Name</h1>
            <p class="public-lead">@Product.ShortDescription</p>
            <div class="action-row">
                <AuthorizeView>
                    <Authorized>
                        <a class="button" href="/add?product=@Product.Slug">Watch this</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="button" href="/signup">Start free</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a class="button secondary" href="/learn">Learn first</a>
            </div>
        </header>

        <section class="panel product-detail public-product-detail">
            <h2>What Clarity keeps an eye on</h2>
            <p>@Product.Outcome</p>
            <p class="muted">@Product.HelpText</p>
            <div class="product-meta">
                <span><strong>Typical check:</strong> every @FormatCadence(Product.DefaultCadenceMinutes)</span>
                <span><strong>Importance:</strong> @Product.DefaultImportance</span>
                <span><strong>History:</strong> saved in My Clarity</span>
                <span><strong>Evidence:</strong> stored with changes</span>
            </div>
        </section>

        <section class="public-section">
            <div class="three-column-info">
                <article>
                    <div class="eyebrow">WATCH</div>
                    <h2>Establish a baseline</h2>
                    <p>The first successful check records what Clarity can observe at that point in time.</p>
                </article>
                <article>
                    <div class="eyebrow">COMPARE</div>
                    <h2>Compare later checks</h2>
                    <p>Later observations are compared with the previous stored result. When the recorded result differs, Clarity keeps the change for review.</p>
                </article>
                <article>
                    <div class="eyebrow">REMEMBER</div>
                    <h2>Keep the history</h2>
                    <p>Saved changes remain available in My Clarity with the evidence Clarity recorded.</p>
                </article>
            </div>
        </section>

        <section class="public-section">
            <h2>Common questions</h2>
            <div class="faq-list">
                <details open>
                    <summary>What happens on the first check?</summary>
                    <p>The first successful observation establishes the baseline. A later observation is required before Clarity can identify a change.</p>
                </details>
                <details>
                    <summary>Can I pause or stop this later?</summary>
                    <p>Yes. Anything you follow can be paused, resumed, reviewed, or archived from My Clarity.</p>
                </details>
                <details>
                    <summary>Does Clarity keep evidence?</summary>
                    <p>Yes. Clarity stores observation snapshots and change evidence so you can review what it recorded later.</p>
                </details>
                <details>
                    <summary>Can I start without paying?</summary>
                    <p>Yes. The Free plan supports up to five active follows with a six-hour minimum cadence and in-app notifications.</p>
                </details>
            </div>
        </section>

        <section class="article-cta">
            <div>
                <div class="eyebrow">STOP CHECKING</div>
                <h2>Let Clarity keep an eye on this.</h2>
                <p>Start with one target and let Clarity begin building the history.</p>
            </div>
            <AuthorizeView>
                <Authorized>
                    <a class="button" href="/add?product=@Product.Slug">Watch this</a>
                </Authorized>
                <NotAuthorized>
                    <a class="button" href="/signup">Create free account</a>
                </NotAuthorized>
            </AuthorizeView>
        </section>
    </div>
}
else
{
    <div class="shell public-shell">
        <header class="hero compact-hero">
            <div class="eyebrow">WHAT CLARITY CAN WATCH</div>
            <h1>Start with what matters to you.</h1>
            <p class="public-lead">Clarity's public catalog focuses on website, domain, DNS, certificate, endpoint, and service-status checks that are fully available today.</p>
            <div class="action-row">
                <AuthorizeView>
                    <Authorized>
                        <a class="button" href="/add">Watch something</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="button" href="/signup">Start free</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        @foreach (var family in PublicCatalog.GetAll()
            .GroupBy(x => x.Family)
            .OrderBy(x => x.Key))
        {
            <section class="public-section">
                <div class="section-intro">
                    <div class="eyebrow">@family.Key.ToUpperInvariant()</div>
                </div>

                <div class="product-grid">
                    @foreach (var product in family)
                    {
                        <a class="product-card" href="/products/@product.Slug">
                            <h2>@product.Name</h2>
                            <p>@product.ShortDescription</p>
                            <span>See how Clarity watches this →</span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="public-section">
            <div class="section-intro">
                <div class="eyebrow">ONE SERVICE</div>
                <h2>One place for everything you ask Clarity to watch.</h2>
                <p>Your follows, status, saved changes, and history stay together in My Clarity.</p>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private PublicClarityProductCatalog PublicCatalog => new(Catalog);
    private ClarityProduct? Product => PublicCatalog.GetBySlug(Slug);
    private bool IsMissingProduct => !string.IsNullOrWhiteSpace(Slug)
        && Product is null;
    private string TitleText => IsMissingProduct
        ? "Watch not found - Clarity Belongs"
        : Product is null
            ? "What Clarity Can Watch - Clarity Belongs"
            : $"{Product.Name} - Clarity Belongs";

    protected override void OnParametersSet()
    {
        if (IsMissingProduct
            && HttpContextAccessor.HttpContext is { Response.HasStarted: false } context)
        {
            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
            context.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }

    private static string FormatCadence(int minutes)
    {
        if (minutes < 60)
            return $"{minutes} minutes";

        if (minutes % 1440 == 0)
            return $"{minutes / 1440} day(s)";

        return $"{minutes / 60} hour(s)";
    }
}
