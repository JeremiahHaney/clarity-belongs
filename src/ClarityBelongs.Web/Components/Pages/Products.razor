@page "/products"
@page "/products/{Slug}"
@inject ClarityProductCatalog Catalog

<PageTitle>@TitleText</PageTitle>

@if (Product is not null)
{
    <HeadContent>
        <meta name="description" content="@Product.ShortDescription" />
    </HeadContent>
}

<div class="shell public-shell">
    @if (Product is null)
    {
        <header class="hero compact-hero">
            <div class="eyebrow">CLARITY PRODUCTS</div>
            <h1>Know what changed.</h1>
            <p class="public-lead">Start with a specific thing you care about. Every monitor feeds the same My Clarity history, evidence, and alert experience.</p>
        </header>

        @foreach (var family in Catalog.GetAll()
            .GroupBy(x => x.Family)
            .OrderBy(x => x.Key))
        {
            <section class="public-section">
                <div class="section-intro">
                    <div class="eyebrow">@family.Key.ToUpperInvariant()</div>
                </div>

                <div class="product-grid">
                    @foreach (var product in family)
                    {
                        <a class="product-card" href="/products/@product.Slug">
                            <div class="eyebrow">@product.MonitorType</div>
                            <h2>@product.Name</h2>
                            <p>@product.ShortDescription</p>
                            <span>Learn more →</span>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="public-section">
            <div class="section-intro">
                <div class="eyebrow">WHY ONE PLATFORM</div>
                <h2>Different questions. Shared history.</h2>
                <p>Clarity uses the same observe → store → compare → history → alert foundation across many kinds of public information. You learn one product experience instead of a collection of unrelated services.</p>
            </div>
        </section>
    }
    else
    {
        <header class="hero compact-hero product-public-hero">
            <div class="eyebrow">@Product.Family.ToUpperInvariant()</div>
            <h1>@Product.Name</h1>
            <p class="public-lead">@Product.ShortDescription</p>
            <div class="action-row">
                <AuthorizeView>
                    <Authorized>
                        <a class="button" href="/add?product=@Product.Slug">Start following</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="button" href="/signup">Start free</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a class="button secondary" href="/learn">Learn first</a>
            </div>
        </header>

        <section class="panel product-detail public-product-detail">
            <h2>What it does</h2>
            <p>@Product.Outcome</p>
            <p class="muted">@Product.HelpText</p>
            <div class="product-meta">
                <span><strong>Default check:</strong> every @FormatCadence(Product.DefaultCadenceMinutes)</span>
                <span><strong>Importance:</strong> @Product.DefaultImportance</span>
                <span><strong>History:</strong> included</span>
                <span><strong>Evidence:</strong> preserved</span>
            </div>
        </section>

        <section class="public-section">
            <div class="three-column-info">
                <article>
                    <div class="eyebrow">OBSERVE</div>
                    <h2>Establish a baseline</h2>
                    <p>Clarity records a normalized first observation so later results have something factual to compare against.</p>
                </article>
                <article>
                    <div class="eyebrow">COMPARE</div>
                    <h2>Detect meaningful differences</h2>
                    <p>Monitor-specific fingerprints avoid turning ordinary noise into a constant stream of false changes.</p>
                </article>
                <article>
                    <div class="eyebrow">REMEMBER</div>
                    <h2>Keep the history</h2>
                    <p>Changes remain in My Clarity with evidence instead of disappearing after an email notification.</p>
                </article>
            </div>
        </section>

        <section class="public-section">
            <h2>Common questions</h2>
            <div class="faq-list">
                <details open>
                    <summary>What happens on the first check?</summary>
                    <p>The first successful observation establishes the baseline. A later observation is required before Clarity can identify a change.</p>
                </details>
                <details>
                    <summary>Can I pause or stop this later?</summary>
                    <p>Yes. Every follow can be paused, resumed, reviewed, or archived from My Clarity.</p>
                </details>
                <details>
                    <summary>Does Clarity keep evidence?</summary>
                    <p>Yes. The core model stores snapshots and before/after evidence so a later alert can be explained.</p>
                </details>
                <details>
                    <summary>Can I start without paying?</summary>
                    <p>Yes. The Free plan supports up to five active follows with a slower minimum cadence and in-app alerts.</p>
                </details>
            </div>
        </section>

        <section class="article-cta">
            <div>
                <div class="eyebrow">READY</div>
                <h2>Stop checking this manually.</h2>
                <p>Start with one target and let Clarity begin building the history.</p>
            </div>
            <AuthorizeView>
                <Authorized>
                    <a class="button" href="/add?product=@Product.Slug">Add this follow</a>
                </Authorized>
                <NotAuthorized>
                    <a class="button" href="/signup">Create free account</a>
                </NotAuthorized>
            </AuthorizeView>
        </section>
    }
</div>

@code {
    [Parameter]
    public string? Slug { get; set; }

    private ClarityProduct? Product => Catalog.GetBySlug(Slug);
    private string TitleText => Product is null
        ? "Monitoring Products - Clarity Belongs"
        : $"{Product.Name} - Clarity Belongs";

    private static string FormatCadence(int minutes)
    {
        if (minutes < 60)
            return $"{minutes} minutes";

        if (minutes % 1440 == 0)
            return $"{minutes / 1440} day(s)";

        return $"{minutes / 60} hour(s)";
    }
}
