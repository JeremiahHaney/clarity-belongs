@page "/admin/reports/site-activity"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ClarityBelongs.Web.Data.ClarityDbContext Db
@rendermode InteractiveServer

<PageTitle>Site Activity · Clarity Belongs</PageTitle>

<div class="shell">
    <header class="hero dashboard-hero">
        <div>
            <div class="eyebrow">ADMIN · USAGE REPORTS</div>
            <h1>Site activity</h1>
            <p>Recent customer activity across accounts, follows, observation runs, detected changes, and notifications.</p>
        </div>
        <a class="button secondary" href="/admin">Admin</a>
    </header>

    @if (_loading)
    {
        <section class="panel"><p>Loading activity...</p></section>
    }
    else if (!_authorized)
    {
        <section class="panel"><h2>Admin access required.</h2></section>
    }
    else
    {
        <section class="summary-grid">
            <article class="summary-card"><strong>@_activeUsers24h.ToString("N0")</strong><span>Users seen · 24h</span></article>
            <article class="summary-card"><strong>@_newFollows24h.ToString("N0")</strong><span>Follows created · 24h</span></article>
            <article class="summary-card"><strong>@_runs24h.ToString("N0")</strong><span>Observation runs · 24h</span></article>
            <article class="summary-card"><strong>@_changes24h.ToString("N0")</strong><span>Meaningful changes · 24h</span></article>
        </section>

        <section class="panel">
            <div class="eyebrow">RECENT USERS</div>
            <h2>Account activity</h2>
            @if (_users.Count == 0)
            {
                <p class="muted">No recent user activity.</p>
            }
            else
            {
                @foreach (var user in _users)
                {
                    <div class="row">
                        <div><strong>@user.DisplayName</strong><div class="muted">@user.Email · last seen @user.LastSeenAtUtc.ToLocalTime().ToString("g")</div></div>
                        <div class="badge">@((DateTime.UtcNow - user.LastSeenAtUtc).TotalHours <= 24 ? "24h" : "Older")</div>
                    </div>
                }
            }
        </section>

        <section class="panel">
            <div class="eyebrow">MONITOR USAGE</div>
            <h2>Most-used monitor types</h2>
            @foreach (var row in _monitorTypes)
            {
                <div class="row"><strong>@row.MonitorType</strong><div class="badge">@row.Count.ToString("N0") follows</div></div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">RUN HEALTH</div>
            <h2>Observation results · 24 hours</h2>
            @foreach (var row in _runStatuses)
            {
                <div class="row"><strong>@row.Status</strong><div class="badge">@row.Count.ToString("N0")</div></div>
            }
        </section>

        <section class="panel">
            <div class="eyebrow">DELIVERY</div>
            <h2>Notification activity · 24 hours</h2>
            <div class="row"><div><strong>Created</strong><div class="muted">Notifications generated in the selected window</div></div><div class="badge">@_notifications24h.ToString("N0")</div></div>
            <div class="row"><div><strong>Failed</strong><div class="muted">Notifications with a delivery failure</div></div><div class="badge">@_failedNotifications24h.ToString("N0")</div></div>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private bool _authorized;
    private int _activeUsers24h;
    private int _newFollows24h;
    private int _runs24h;
    private int _changes24h;
    private int _notifications24h;
    private int _failedNotifications24h;
    private List<AppUser> _users = [];
    private List<MonitorTypeRow> _monitorTypes = [];
    private List<RunStatusRow> _runStatuses = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _authorized = AdminAccess.IsAllowed(state.User, Configuration);

        if (!_authorized)
        {
            _loading = false;
            return;
        }

        var sinceUtc = DateTime.UtcNow.AddHours(-24);
        _activeUsers24h = await Db.Users.CountAsync(user => user.LastSeenAtUtc >= sinceUtc);
        _newFollows24h = await Db.Follows.CountAsync(follow => follow.CreatedAtUtc >= sinceUtc);
        _runs24h = await Db.ObservationRuns.CountAsync(run => run.StartedAtUtc >= sinceUtc);
        _changes24h = await Db.Changes.CountAsync(change => change.IsMeaningful && change.DetectedAtUtc >= sinceUtc);
        _notifications24h = await Db.Notifications.CountAsync(notification => notification.CreatedAtUtc >= sinceUtc);
        _failedNotifications24h = await Db.Notifications.CountAsync(notification => notification.FailedAtUtc >= sinceUtc);
        _users = await Db.Users
            .AsNoTracking()
            .OrderByDescending(user => user.LastSeenAtUtc)
            .Take(20)
            .ToListAsync();
        _monitorTypes = await Db.Follows
            .AsNoTracking()
            .GroupBy(follow => follow.MonitorType)
            .Select(group => new MonitorTypeRow(group.Key, group.Count()))
            .OrderByDescending(row => row.Count)
            .ToListAsync();
        _runStatuses = await Db.ObservationRuns
            .AsNoTracking()
            .Where(run => run.StartedAtUtc >= sinceUtc)
            .GroupBy(run => run.Status)
            .Select(group => new RunStatusRow(group.Key, group.Count()))
            .OrderByDescending(row => row.Count)
            .ToListAsync();

        _loading = false;
    }

    private sealed record MonitorTypeRow(string MonitorType, int Count);
    private sealed record RunStatusRow(string Status, int Count);
}
