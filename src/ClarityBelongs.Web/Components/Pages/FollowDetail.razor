@page "/follows/{FollowId:long}"
@attribute [Authorize]
@inject FollowManagementService Follows
@inject CurrentAccountService CurrentAccount
@inject MembershipService Memberships
@inject ClarityBelongs.Web.Observation.ObservationEngine Engine
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Follow</PageTitle>

<div class="shell">
    @if (Model is null)
    {
        <section class="panel">
            <p>Loading follow...</p>
        </section>
    }
    else
    {
        <header class="hero compact-hero detail-hero">
            <div>
                <div class="eyebrow">@Model.Follow.MonitorType</div>
                <h1>@Model.Follow.Name</h1>
                <p>@Model.Target.PrimaryUri</p>
            </div>
            <div class="action-row">
                <button class="button secondary" @onclick="RunNowAsync" disabled="@Busy">Check now</button>
                <button class="button secondary" @onclick="TogglePauseAsync" disabled="@Busy">
                    @(Model.Follow.Status == FollowStatuses.Paused ? "Resume" : "Pause")
                </button>
            </div>
        </header>

        <section class="summary-grid four">
            <article class="summary-card">
                <strong>@Model.Follow.Status</strong>
                <span>Status</span>
            </article>
            <article class="summary-card">
                <strong>@Model.Follow.Importance</strong>
                <span>Importance</span>
            </article>
            <article class="summary-card">
                <strong>@FormatTime(Model.Follow.LastCheckedAtUtc)</strong>
                <span>Last check</span>
            </article>
            <article class="summary-card">
                <strong>@Model.Changes.Count</strong>
                <span>Changes</span>
            </article>
        </section>

        @if (Membership is not null)
        {
            <section class="setup-note plan-notice">
                <strong>@Membership.Plan.Name plan</strong>
                <span>Fastest available cadence: @FormatCadence(Membership.Plan.MinimumCadenceMinutes). <a href="/pricing">Compare plans</a>.</span>
            </section>
        }

        <section class="panel">
            <h2>Settings</h2>
            <div class="form-grid">
                <label class="field">
                    <span>Check every</span>
                    <select @bind="CadenceMinutes">
                        @foreach (var cadence in AvailableCadences)
                        {
                            <option value="@cadence">@FormatCadence(cadence)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Importance</span>
                    <select @bind="Importance">
                        <option>Low</option>
                        <option>Normal</option>
                        <option>High</option>
                        <option>Critical</option>
                    </select>
                </label>
                <label class="check-field">
                    <input type="checkbox" @bind="AlertsEnabled" />
                    <span>Create alerts for meaningful changes</span>
                </label>
            </div>
            <button class="button secondary" @onclick="SaveSettingsAsync" disabled="@Busy">Save settings</button>
        </section>

        <section class="panel">
            <h2>History</h2>
            @if (Model.Changes.Count == 0)
            {
                <p class="muted">No meaningful changes yet. The first successful check establishes the baseline.</p>
            }
            else
            {
                @foreach (var change in Model.Changes)
                {
                    <article class="change history-card">
                        <div class="change-topline">
                            <a href="/follows/@FollowId/changes/@change.ChangeId"><strong>@change.Title</strong></a>
                            <span>@change.DetectedAtUtc.ToLocalTime().ToString("g")</span>
                        </div>
                        <div>@change.Summary</div>
                        <div class="action-row small-actions">
                            <span class="badge">@change.Severity</span>
                            <a class="text-button" href="/follows/@FollowId/changes/@change.ChangeId">View before / after</a>
                            @if (!change.IsAcknowledged)
                            {
                                <button class="text-button" @onclick="() => AcknowledgeAsync(change.ChangeId)">Mark reviewed</button>
                            }
                            else
                            {
                                <span class="muted">Reviewed</span>
                            }
                        </div>
                    </article>
                }
            }
        </section>

        <section class="panel">
            <h2>Alerts</h2>
            @if (Model.Notifications.Count == 0)
            {
                <p class="muted">No notifications have been created yet.</p>
            }
            else
            {
                @foreach (var notification in Model.Notifications)
                {
                    <div class="row">
                        <div>
                            <strong>@notification.Subject</strong>
                            <div class="muted">@notification.Channel · @notification.Status</div>
                        </div>
                        <span>@notification.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                    </div>
                }
            }
        </section>

        <section class="danger-zone">
            <button class="text-button danger" @onclick="ArchiveAsync">Stop following</button>
        </section>
    }
</div>

@code {
    [Parameter]
    public long FollowId { get; set; }

    private static readonly int[] CadenceChoices = [5, 15, 60, 360, 720, 1440, 10080];
    private FollowDetailModel? Model { get; set; }
    private AccountSession? Account { get; set; }
    private MembershipSummary? Membership { get; set; }
    private int CadenceMinutes { get; set; }
    private string Importance { get; set; } = "Normal";
    private bool AlertsEnabled { get; set; } = true;
    private bool Busy { get; set; }

    private IEnumerable<int> AvailableCadences => Membership is null
        ? CadenceChoices
        : CadenceChoices.Where(x => x >= Membership.Plan.MinimumCadenceMinutes);

    protected override async Task OnParametersSetAsync()
    {
        Account = await CurrentAccount.RequireAsync();
        Membership = await Memberships.GetAsync(
            Account.UserId,
            Account.WorkspaceId);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (Account is null)
            return;

        Model = await Follows.GetAsync(
            Account.WorkspaceId,
            FollowId);

        if (Model is null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        CadenceMinutes = Model.Follow.CheckCadenceMinutes;
        Importance = Model.Follow.Importance;
        AlertsEnabled = Model.AlertRules.Any(x => x.IsEnabled);
    }

    private async Task RunNowAsync()
    {
        Busy = true;
        await Engine.RunFollowAsync(FollowId);
        Busy = false;
        await ReloadAsync();
    }

    private async Task TogglePauseAsync()
    {
        if (Model is null || Account is null)
            return;

        Busy = true;
        await Follows.SetPausedAsync(
            Account.WorkspaceId,
            FollowId,
            Model.Follow.Status != FollowStatuses.Paused);
        Busy = false;
        await ReloadAsync();
    }

    private async Task SaveSettingsAsync()
    {
        if (Account is null)
            return;

        Busy = true;
        await Follows.UpdateSettingsAsync(
            Account.UserId,
            Account.WorkspaceId,
            FollowId,
            CadenceMinutes,
            Importance,
            AlertsEnabled);
        Busy = false;
        await ReloadAsync();
    }

    private async Task AcknowledgeAsync(long changeId)
    {
        if (Account is null)
            return;

        await Follows.AcknowledgeAsync(
            Account.WorkspaceId,
            FollowId,
            changeId);
        await ReloadAsync();
    }

    private async Task ArchiveAsync()
    {
        if (Account is null)
            return;

        await Follows.ArchiveAsync(
            Account.WorkspaceId,
            FollowId);
        Navigation.NavigateTo("/");
    }

    private static string FormatTime(DateTime? value) => value.HasValue
        ? value.Value.ToLocalTime().ToString("g")
        : "Not yet";

    private static string FormatCadence(int minutes)
    {
        if (minutes >= 10080)
            return "1 week";

        if (minutes >= 1440)
            return $"{minutes / 1440} day";

        if (minutes >= 60)
            return $"{minutes / 60} hour";

        return $"{minutes} minutes";
    }
}
