@inherits LayoutComponentBase

<style>
    .clarity-social-band {
        margin-top: 54px;
        padding: 34px 0;
        background: linear-gradient(135deg, #17312f, #1f4252);
        color: white;
    }

    .clarity-social-inner {
        width: min(1100px, calc(100% - 32px));
        margin: 0 auto;
    }

    .clarity-social-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .clarity-social-heading .eyebrow {
        color: #9ed3cd;
    }

    .clarity-social-heading h2 {
        margin: 7px 0 0;
        font-size: clamp(26px, 4vw, 36px);
    }

    .clarity-social-heading p {
        max-width: 440px;
        margin: 0;
        color: #c9d8dc;
    }

    .clarity-social-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .clarity-social-card {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 78px;
        padding: 16px;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 15px;
        background: rgba(255,255,255,.07);
        color: white;
        text-decoration: none;
        transition: transform .16s ease, background .16s ease, border-color .16s ease;
    }

    .clarity-social-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255,255,255,.28);
        background: rgba(255,255,255,.12);
    }

    .clarity-social-icon {
        display: grid;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        place-items: center;
        border-radius: 12px;
        background: #e8f5f1;
        color: #287a72;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: -.02em;
    }

    .clarity-social-copy {
        display: grid;
        gap: 2px;
    }

    .clarity-social-copy strong {
        font-size: 14px;
    }

    .clarity-social-copy small {
        color: #c9d8dc;
        font-size: 12px;
    }

    .clarity-social-arrow {
        margin-left: auto;
        color: #9ed3cd;
        font-size: 18px;
    }

    .site-nav-menu {
        margin-left: auto;
    }

    .site-nav-menu > summary {
        display: none;
    }

    .site-nav-menu > nav {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .site-nav-menu a.active:not(.primary-link) {
        color: #1f6f68;
        font-weight: 800;
    }

    .site-nav-menu a {
        white-space: nowrap;
    }

    @@media (max-width: 1050px) {
        .site-header {
            align-items: flex-start;
        }

        .brand small {
            display: none;
        }

        .site-nav-menu > nav {
            gap: 12px;
        }
    }

    @@media (max-width: 820px) {
        .site-header {
            position: relative;
            align-items: center;
            flex-direction: row;
            gap: 12px;
        }

        .site-nav-menu > summary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            min-height: 44px;
            padding: 8px 12px;
            border: 1px solid #d5dbe0;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            font-weight: 800;
            list-style: none;
        }

        .site-nav-menu > summary::-webkit-details-marker {
            display: none;
        }

        .site-nav-menu > nav {
            display: none;
            position: absolute;
            z-index: 20;
            top: calc(100% + 2px);
            right: 0;
            width: min(320px, calc(100vw - 32px));
            padding: 12px;
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
            border: 1px solid #dfe7e6;
            border-radius: 14px;
            background: white;
            box-shadow: 0 18px 46px rgba(25, 35, 45, .14);
        }

        .site-nav-menu[open] > nav {
            display: flex;
        }

        .site-nav-menu nav a {
            padding: 11px 12px;
            border-radius: 9px;
        }

        .site-nav-menu nav a:hover,
        .site-nav-menu nav a.active:not(.primary-link) {
            background: #f3f7f6;
        }

        .site-nav-menu nav .primary-link {
            margin-top: 4px;
            text-align: center;
        }

        .clarity-social-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .clarity-social-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 430px) {
        .site-header {
            width: min(100% - 20px, 1180px);
        }

        .brand {
            gap: 6px;
        }

        .brand-mark,
        .brand-mark svg {
            width: 34px;
            height: 34px;
        }

        .brand-copy > span {
            font-size: 15px;
        }
    }
</style>

<div class="site-frame">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Clarity Belongs home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img">
                    <rect x="4" y="4" width="40" height="40" rx="12" fill="currentColor" opacity=".12" />
                    <path d="M13 25c4.4-6.7 9.1-10 14-10 3.4 0 6.5 1.5 9.3 4.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                    <path d="M13 25c4.4 6.7 9.1 10 14 10 3.4 0 6.5-1.5 9.3-4.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                    <circle cx="27" cy="25" r="4.2" fill="currentColor" />
                </svg>
            </span>
            <span class="brand-copy">
                <span>Clarity Belongs</span>
                <small>KEEP AN EYE ON WHAT MATTERS</small>
            </span>
        </a>

        <details class="site-nav-menu">
            <summary aria-label="Open navigation">Menu</summary>
            <nav aria-label="Primary navigation">
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/my-clarity">My Clarity</NavLink>
                        <NavLink class="primary-link" href="/add">Watch Something</NavLink>
                        <NavLink href="/products">What It Watches</NavLink>
                        <NavLink href="/tools">Free Tools</NavLink>
                        <NavLink href="/learn">Learn</NavLink>
                        <NavLink href="/account">Account</NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/products">What It Watches</NavLink>
                        <NavLink href="/tools">Free Tools</NavLink>
                        <NavLink href="/learn">Learn</NavLink>
                        <NavLink href="/pricing">Pricing</NavLink>
                        <NavLink href="/about">About</NavLink>
                        <NavLink href="/login">Sign in</NavLink>
                        <NavLink class="primary-link" href="/signup">Start free</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </details>
    </header>

    <main>
        @Body
    </main>

    <section class="clarity-social-band" aria-label="Clarity Belongs social channels">
        <div class="clarity-social-inner">
            <div class="clarity-social-heading">
                <div>
                    <div class="eyebrow">KEEP AN EYE ON WHAT MATTERS</div>
                    <h2>Find @@claritybelongs.</h2>
                </div>
                <p>Useful changes, simple explanations, and things worth knowing without having to keep checking.</p>
            </div>
            <div class="clarity-social-grid">
                <a class="clarity-social-card" href="https://www.instagram.com/claritybelongs" target="_blank" rel="noopener noreferrer">
                    <span class="clarity-social-icon">IG</span>
                    <span class="clarity-social-copy"><strong>Instagram</strong><small>@@claritybelongs</small></span>
                    <span class="clarity-social-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="clarity-social-card" href="https://www.tiktok.com/@@claritybelongs" target="_blank" rel="noopener noreferrer">
                    <span class="clarity-social-icon">TT</span>
                    <span class="clarity-social-copy"><strong>TikTok</strong><small>@@claritybelongs</small></span>
                    <span class="clarity-social-arrow" aria-hidden="true">↗</span>
                </a>
                <a class="clarity-social-card" href="https://www.youtube.com/@@claritybelongs" target="_blank" rel="noopener noreferrer">
                    <span class="clarity-social-icon">YT</span>
                    <span class="clarity-social-copy"><strong>YouTube</strong><small>@@claritybelongs</small></span>
                    <span class="clarity-social-arrow" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>

    <footer class="site-footer expanded-footer">
        <div>
            <strong>Clarity belongs to everyone.</strong>
            <span>Tell Clarity what matters. We keep an eye on it.</span>
        </div>
        <div class="footer-links">
            <a href="/products">What It Watches</a>
            <a href="/tools">Free Tools</a>
            <a href="/learn">Learn</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <a href="/support">Support</a>
            <a href="/contact">Contact</a>
            <a href="/feedback">Product feedback</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
        </div>
    </footer>
</div>
