@inherits LayoutComponentBase

<div class="site-frame">
    <header class="site-header">
        <a class="brand" href="/" aria-label="Clarity Belongs home">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img">
                    <rect x="4" y="4" width="40" height="40" rx="12" fill="currentColor" opacity=".12" />
                    <path d="M13 25c4.4-6.7 9.1-10 14-10 3.4 0 6.5 1.5 9.3 4.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                    <path d="M13 25c4.4 6.7 9.1 10 14 10 3.4 0 6.5-1.5 9.3-4.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                    <circle cx="27" cy="25" r="4.2" fill="currentColor" />
                </svg>
            </span>
            <span class="brand-copy">
                <span>Clarity Belongs</span>
                <small>KNOW WHAT CHANGED</small>
            </span>
        </a>
        <nav>
            <a href="/products">Products</a>
            <a href="/learn">Learn</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <AuthorizeView>
                <Authorized>
                    <a href="/my-clarity">My Clarity</a>
                    <a href="/account">Account</a>
                    <a class="primary-link" href="/add">Add Follow</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Sign in</a>
                    <a class="primary-link" href="/signup">Start free</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer expanded-footer">
        <div>
            <strong>Clarity belongs to everyone.</strong>
            <span>See what changed. Know what matters.</span>
        </div>
        <div class="footer-links">
            <a href="/products">Products</a>
            <a href="/learn">Learn</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <a href="/support">Support</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
        </div>
    </footer>
</div>
