@inherits LayoutComponentBase

<div class="site-frame">
    <header class="site-header">
        <a class="brand" href="/">
            <span>Clarity Belongs</span>
            <small>KNOW WHAT CHANGED</small>
        </a>
        <nav>
            <a href="/products">Products</a>
            <a href="/learn">Learn</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <AuthorizeView>
                <Authorized>
                    <a href="/my-clarity">My Clarity</a>
                    <a href="/account">Account</a>
                    <a class="primary-link" href="/add">Add Follow</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Sign in</a>
                    <a class="primary-link" href="/signup">Start free</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer expanded-footer">
        <div>
            <strong>Clarity belongs to everyone.</strong>
            <span>See what changed. Know what matters.</span>
        </div>
        <div class="footer-links">
            <a href="/products">Products</a>
            <a href="/learn">Learn</a>
            <a href="/pricing">Pricing</a>
            <a href="/about">About</a>
            <a href="/support">Support</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
        </div>
    </footer>
</div>
